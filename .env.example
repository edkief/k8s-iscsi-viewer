# Prometheus base URL for PVC usage metrics (optional — app works without it)
# PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090

# Lookback range for historic usage queries on unmounted volumes (default: 7d)
# USAGE_LOOKBACK=7d

# TTL for the live volume data cache in seconds (default: 60)
# CACHE_TTL_SECONDS=60

# TTL for the historic usage cache in seconds (default: 600)
# HISTORIC_USAGE_TTL_SECONDS=600

# Comma-separated CSI driver names to include (default: any driver matching "democratic-csi")
# DRIVER_NAMES=org.democratic-csi.iscsi,org.democratic-csi.nfs

# --- TrueNAS (live zvol detail / block-mode usage) ---
# Base URL of the TrueNAS host. Both URL and API key are required to enable it.
# TRUENAS_URL=https://truenas.example.com
# TRUENAS_API_KEY=

# Skip TLS certificate verification for self-signed certs (default: false)
# TRUENAS_INSECURE_TLS=false

# TTL for the TrueNAS dataset query cache in seconds (default: 300)
# TRUENAS_CACHE_TTL_SECONDS=300
